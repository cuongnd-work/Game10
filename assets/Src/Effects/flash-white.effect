// Cocos Creator 3.8 custom sprite effect – "flash white" cho unlock.
// Uniform:
//   flashAmount (0..1): 0 = giữ nguyên texture, 1 = lóe hoàn toàn theo flashColor.
//   flashColor: màu flash (default trắng).
// Sử dụng: tạo Material dùng effect này, gán vào Sprite, tween amount 1→0.

CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        flashColor: { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color } }
        flashParams: { value: [0.0, 0.0, 0.0, 0.0], editor: { visible: false } }
        flashAmount: { value: 0.0, target: flashParams.x, editor: { range: [0, 1, 0.01] } }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    pos = cc_matViewProj * pos;

    uv0 = a_texCoord;
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  in vec2 uv0;

  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform Flash {
    vec4 flashColor;
    vec4 flashParams;
  };

  vec4 frag () {
    vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    o *= color;

    float amount = clamp(flashParams.x, 0.0, 1.0);
    // Lerp RGB về flashColor, giữ nguyên alpha để không phá cut-out.
    // Nhân với o.a để pixel trong suốt không bị bơm trắng vào.
    vec3 target = flashColor.rgb * o.a;
    o.rgb = mix(o.rgb, target, amount);

    ALPHA_TEST(o);
    return o;
  }
}%
